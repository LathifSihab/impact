---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import EventRow from '../components/EventRow.astro';
import Marquee from '../components/Marquee.astro';
import { ORGANISATION, WEBSITE } from '../lib/seo';

const foundations = (await getCollection('foundations')).sort((a, b) =>
  a.data.number.localeCompare(b.data.number));
const ageGroups = await getCollection('ageGroups');
const formats = (await getCollection('formats')).sort((a, b) => a.data.order - b.data.order);
const events = await getCollection('events');
const journal = (await getCollection('journal')).sort(
  (a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
const testimonials = (await getCollection('testimonials')).filter((t) => t.data.consentOnFile);

const formatName = (id: string) => formats.find((f) => f.id === id)?.data.name ?? '';
const teaser = events
  .filter((e) => e.data.status === 'waitlist' || e.data.status === 'open')
  .sort((a, b) => a.data.editionYear - b.data.editionYear)
  .slice(0, 3);

const peers = formats.filter((f) => !f.data.isHosted);
const hosted = formats.find((f) => f.data.isHosted);

const routes = [
  ['01', 'Jongere of ouder', 'Bekijk welke events eraan komen en zet je op de wachtlijst.', 'Bekijk events', '/events#upcoming'],
  ['02', 'Bedrijf of sponsor', 'Partnerships, sponsoring en activations voor jouw merk of team.', 'Voor bedrijven', '/samenwerken#bedrijven'],
  ['03', 'Club of organisatie', 'Bouw samen met ons een experience voor jouw community.', 'Hosted Experiences', '/hosted-experiences'],
  ['04', 'Coach of expert', "Breng je expertise binnen in onze programma's en activaties.", 'Word expert', '/samenwerken#experts'],
  ['05', 'Steun onze missie', 'Geef via IMPACT FOR ALL een jongere een plaats die er anders geen krijgt.', 'Draag bij', '/social-impact#draag-bij'],
  ['06', 'Nieuw hier', 'Ontdek wie IMPACT is, waar we in geloven en hoe we werken.', 'Ontdek IMPACT', '/over'],
];
const categoryLabel: Record<string, string> = {
  'past-event': 'Past event', story: 'Story', insight: 'Insight',
  social: 'IMPACT FOR ALL', partner: 'Partner', news: 'News',
};
---

<Base
  title="IMPACT — Building foundations for life"
  description="Youth development voor jongeren van 8 tot 25 jaar. Camps, Days, Retreats, Community en Hosted Experiences, opgebouwd rond zes fundamenten. Bekijk de upcoming events."
  nav="home"
  jsonLd={[ORGANISATION, WEBSITE]}
  hasOwnSignup={true}
>
  <Hero
    variant="home"
    image="assets/img/court-169.jpg"
    alt="Jongeren in actie op het basketbalveld tijdens een IMPACT Camp"
    video="hero"
    title="Building foundations for life."
    trust={['8–25 jaar', 'Zes fundamenten', 'Sinds 2026 in Antwerpen']}
    split={true}
  >
    <div class="hero-bottom reveal">
      <p>
        Youth development through experiences, connection and growth. IMPACT begeleidt jongeren tussen
        8 en 25 jaar in het bouwen aan sterke fundamenten voor het leven.
      </p>
      <div class="actions">
        <a href="/over" class="pill pill--primary">Ontdek IMPACT</a>
        <a href="/events#upcoming" class="pill pill--ghost">Bekijk events</a>
      </div>
    </div>
  </Hero>

  <section class="section section--sand" id="voor-jou">
    <div class="wrap">
      <div class="sec-head">
        <span class="running">Waarvoor kom je?</span>
        <div><h2 class="d-l">Vind meteen jouw volgende stap</h2></div>
        <p class="body">Zes wegen door IMPACT. Kies degene die bij jou past — de rest kan je daarna ontdekken.</p>
      </div>
      <div class="routes">
        {routes.map(([n, title, body, cta, href]) => (
          <a class="route" href={href}>
            <span class="n">{n}</span>
            <h3>{title}</h3>
            <p class="body">{body}</p>
            <span class="tlink">{cta}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--red" id="fundamenten">
    <div class="wrap">
      <div class="sec-head">
        <span class="running">The foundations</span>
        <div><h2 class="d-l">Six foundations. One stronger generation.</h2></div>
        <div class="strip-nav">
          <button class="strip-btn" type="button" data-strip-prev aria-label="Vorige fundamenten">&#8592;</button>
          <button class="strip-btn" type="button" data-strip-next aria-label="Volgende fundamenten">&#8594;</button>
        </div>
      </div>
      <div class="measure-2 strip-intro">
        <p class="body">
          Elk Camp, elke Day en elke Retreat wordt vanuit deze zes fundamenten opgebouwd. Het medium
          verandert. De fundamenten blijven.
        </p>
        <p class="body">
          Hoe ze tot leven komen, en voor welke leeftijd, verschilt per activatie — via sport,
          community, retreats of workshops.
        </p>
      </div>
    </div>

    <div class="strip fund-track" role="region" aria-label="Onze zes fundamenten, horizontaal scrollbaar">
      {foundations.map((f) => (
        <article class="strip-card">
          <div class="strip-img">
            <img src={'/' + f.data.image} alt={f.data.alt} loading="lazy" />
            <span class="chip">[{f.data.number}] {f.data.name}</span>
          </div>
          <p class="body">{f.data.nlBody}</p>
        </article>
      ))}
    </div>

    <div class="wrap">
      <div class="fund-foot">
        <div class="progress">
          <div class="track"><span data-progress></span></div>
          <span class="counter" data-counter>01 / {String(foundations.length).padStart(2, '0')}</span>
        </div>
        <a href="/over#fundamenten" class="tlink">Meer over onze fundamenten</a>
      </div>
    </div>
  </section>

  <section class="section section--sand" id="voor-wie">
    <div class="wrap">
      <div class="sec-head">
        <span class="running">Voor wie</span>
        <div><h2 class="d-l">Built for every stage of growth</h2></div>
        <p class="body">
          Elke levensfase brengt andere noden mee. Onze activaties worden telkens afgestemd op de
          leeftijdsgroep waarvoor ze gebouwd worden.
        </p>
      </div>
      <div class="cards-3">
        {ageGroups.map((g) => (
          <article class="who-card">
            <img src={'/' + g.data.image} alt={g.data.alt} loading="lazy" />
            <div class="inner">
              <div class="age">{g.data.label}</div>
              <div class="tagline">{g.data.tagline}</div>
              <p class="body">{g.data.body}</p>
              <div class="tags">{g.data.formats.map((f) => <span>{f}</span>)}</div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section" id="events">
    <div class="wrap">
      <div class="sec-head">
        <span class="running">Upcoming IMPACT events</span>
        <div><h2 class="d-l">Wat kan je binnenkort meemaken?</h2></div>
        <p><a href="/events#upcoming" class="tlink">Alle events</a></p>
      </div>
      {teaser.map((event) => (
        <EventRow event={event} formatName={formatName(event.data.format.id)} />
      ))}
      <p class="note body">
        Data en locaties worden bevestigd zodra de wachtlijst voldoende groot is. Inschrijven op de
        wachtlijst is gratis en verplicht je tot niets.
      </p>
    </div>
  </section>

  <section class="section section--black" id="formats">
    <div class="wrap">
      <div class="sec-head">
        <span class="running">Onze formats</span>
        <div><h2 class="d-l align-right">Het medium verandert. De fundamenten blijven.</h2></div>
        <p><a href="/events#formats" class="tlink">Ontdek onze formats</a></p>
      </div>
      {peers.map((f) => (
        <a class="format-row" href={`/events#${f.id}`}>
          <span class="n">{String(f.data.order).padStart(2, '0')}</span>
          <span class="name">IMPACT <span class="red">{f.data.bracketName}</span></span>
          <p class="body desc">{f.data.description}</p>
          <span class="m">{f.data.meta}</span>
        </a>
      ))}
      {hosted && (
        <a class="format-row format-row--hosted" href="/hosted-experiences">
          <span class="n">—</span>
          <span class="name">IMPACT <span class="red">{hosted.data.bracketName}</span></span>
          <p class="body desc">{hosted.data.description}</p>
          <span class="m">{hosted.data.meta}</span>
        </a>
      )}
    </div>
  </section>

  <section class="section">
    <div class="wrap two-col">
      <div>
        <span class="running">Social impact</span>
        <div class="d-m" style="margin:22px 0 26px">IMPACT <span class="red">for all</span></div>
        <h2 class="d-l">Talent is everywhere. Opportunity isn't.</h2>
        <p class="body" style="margin-top:26px;max-width:560px">
          We willen vermijden dat kwalitatieve experiences en ontwikkelingskansen alleen toegankelijk
          zijn voor jongeren van wie de ouders ze kunnen betalen. Via partnerships, sponsoring en
          bijdragen bouwen we middelen op waarmee we jongeren ondersteunen — tijdens én na een
          IMPACT-activatie.
        </p>
        <div style="display:flex;gap:12px;flex-wrap:wrap;margin-top:32px">
          <a href="/social-impact" class="pill pill--primary">Ontdek IMPACT FOR ALL</a>
          <a href="/social-impact#draag-bij" class="pill pill--secondary">Draag bij</a>
        </div>
      </div>
      <div>
        <img src="/assets/img/hands-45.jpg" alt="Eén jongere, één verhaal" loading="lazy"
             style="height:600px;object-fit:cover;width:100%" />
        {testimonials.length > 0 && (
          <blockquote class="quote">
            {testimonials[0].data.quote}
            <cite>{testimonials[0].data.attribution} · {testimonials[0].data.edition}</cite>
          </blockquote>
        )}
      </div>
    </div>
  </section>

  <section class="section section--sand" id="journal-teaser">
    <div class="wrap">
      <div class="sec-head">
        <span class="running">Journal</span>
        <div><h2 class="d-l">Wat we meemaakten, leerden en bouwden</h2></div>
        <p><a href="/journal" class="tlink">Ontdek journal</a></p>
      </div>
      <div class="cards-4">
        {journal.slice(0, 4).map((post) => (
          <a class="jcard" href={`/journal/${post.id}`}>
            <img src={'/' + post.data.image} alt={post.data.alt} loading="lazy" />
            <span class="tag">{categoryLabel[post.data.category]}</span>
            <h3>{post.data.title}</h3>
            <p class="meta">{post.data.meta}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section" id="nieuwsbrief">
    <div class="wrap two-col">
      <div>
        <span class="running">Nieuwsbrief</span>
        <h2 class="d-l" style="margin:22px 0">Join the IMPACT community</h2>
        <p class="body" style="max-width:460px">
          Blijf op de hoogte van nieuwe events, verhalen, partnerships en alles wat er binnen IMPACT
          ontstaat.
        </p>
      </div>
      <form data-newsletter method="post" action="/api/newsletter" novalidate>
        <div class="field-row">
          <label class="sr-only" for="home-news">E-mailadres</label>
          <input id="home-news" type="email" name="email" placeholder="jouw e-mailadres" required />
          <button type="submit" class="pill pill--primary">Inschrijven</button>
        </div>
        <p class="form-msg" role="status"></p>
        <p class="meta">Eén mail per maand, geen spam. Uitschrijven kan altijd.</p>
      </form>
    </div>
  </section>

  <Marquee />
</Base>
