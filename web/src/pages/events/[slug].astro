---
import { getCollection, getEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Hero from '../../components/Hero.astro';
import { eventLd, faqLd } from '../../lib/seo';

/* Every event in the CMS gets its own page and, where the status says so, its
   own waitlist. Adding an event is a content change — no code, no rebuild by us. */
export async function getStaticPaths() {
  const events = await getCollection('events');
  return events.map((event) => ({ params: { slug: event.id }, props: { event } }));
}

const { event } = Astro.props;
const e = event.data;

const format = await getEntry('formats', e.format.id);
const foundations = await Promise.all((e.foundations ?? []).map((f) => getEntry('foundations', f.id)));
const experts = await Promise.all((e.experts ?? []).map((x) => getEntry('experts', x.id)));

const answered = (e.faq ?? []).filter((f) => f.a && !f.a.startsWith('Antwoord volgt'));
const jsonLd = [eventLd({ ...e, slug: event.id }), faqLd(answered)].filter(Boolean);

const isWaitlist = e.status === 'waitlist';
const isOpen = e.status === 'open';
const meta: [string, string][] = [
  ['Format', format?.data.name ?? ''],
  ['Datum', e.dateText],
  ['Locatie', e.location],
  ['Leeftijd', `${e.ageMin}–${e.ageMax} jaar`],
  ['Prijs', e.price ?? 'Volgt bij bevestiging'],
];
const statusPill = {
  waitlist: 'Wachtlijst open', open: 'Inschrijvingen open', full: 'Volzet', past: 'Afgelopen editie',
}[e.status];
---

<Base
  title={e.seo.title}
  description={e.seo.description}
  nav="events"
  jsonLd={jsonLd}
  suppressDome={true}
  ogImage={'/' + e.heroImage.replace(/^\//, '')}
>
  <Hero
    variant="event"
    image={e.heroImage}
    alt={e.title}
    video={e.heroVideo}
    kicker={`IMPACT <span class="red">${format?.data.bracketName ?? ''}</span>`}
    title={e.title.replace(/^IMPACT [^—]+— /, '')}
    standfirst={e.standfirst}
    pills={[
      { label: format?.data.name ?? '', tone: 'red' },
      { label: `${e.ageMin}–${e.ageMax} jaar` },
      { label: statusPill },
    ]}
  />

  <div class="metabar">
    <div class="wrap">
      <div class="pairs">
        {meta.map(([k, v]) => (
          <div><div class="k">{k}</div><div class="v">{v}</div></div>
        ))}
      </div>
      {e.status !== 'past' && (
        <a href="#wachtlijst" class="pill pill--primary">
          {isOpen ? 'Schrijf je in' : 'Zet me op de wachtlijst'}
        </a>
      )}
    </div>
  </div>

  <div class="wrap event-body">
    <div>
      <section>
        <span class="running">Wat is het</span>
        <h2>{e.standfirst}</h2>
        <p class="intro">{e.intro}</p>
      </section>

      {e.programmeDays.length > 0 && (
        <section>
          <span class="running">Programma</span>
          <div style="margin-top:26px">
            {e.programmeDays.map((d) => (
              <div class="day-row">
                <div class="d">{d.day}</div>
                <div><h3>{d.title}</h3><p class="body">{d.body}</p></div>
              </div>
            ))}
          </div>
        </section>
      )}

      {foundations.length > 0 && (
        <section>
          <span class="running">Welke fundamenten</span>
          <div class="fund-grid" style="margin-top:26px">
            {foundations.map((f) => f && (
              <div class="fund-cell">
                <div class="n">[{f.data.number}]</div>
                <h3>{f.data.name}</h3>
                <p class="body">{f.data.enOneLiner}</p>
              </div>
            ))}
          </div>
        </section>
      )}

      {experts.length > 0 && (
        <section id="experts">
          <span class="running">Experts &amp; coaches</span>
          <p class="body" style="max-width:620px;margin:16px 0 26px">
            Deze editie wordt begeleid door ons kernteam van experts, elk verbonden aan één of meerdere fundamenten.
          </p>
          <div class="expert-grid">
            {experts.map((x) => x && (
              <article class="expert">
                <h4>{x.data.name}</h4>
                <p class="org">{x.data.org}</p>
                <p class="r">{x.data.foundations.map((n) => `[${n}]`).join('  ')}</p>
              </article>
            ))}
          </div>
        </section>
      )}

      {e.faq.length > 0 && (
        <section>
          <span class="running">Veelgestelde vragen</span>
          <div style="margin-top:26px">
            {e.faq.map((f) => (
              <details class="faq">
                <summary>{f.q}<span class="plus">+</span></summary>
                <p class="a body">{f.a}</p>
              </details>
            ))}
          </div>
        </section>
      )}
    </div>

    <aside class="sticky-col" id="wachtlijst">
      {e.status === 'past' ? (
        <div class="wl-card">
          <span class="label">[ Afgelopen editie ]</span>
          <h2 style="margin-top:16px">Deze editie is voorbij</h2>
          <p class="body">De recap, foto's en verhalen van deze editie staan in Journal.</p>
          <a class="pill pill--primary" href="/journal" style="margin-top:18px">Bekijk de recap</a>
        </div>
      ) : (
        <div class="wl-card">
          <span class="label">[ {isWaitlist ? 'Wachtlijst' : 'Inschrijven'} ]</span>
          <h2 style="margin-top:16px">
            {isWaitlist ? 'Deze editie is nog niet bevestigd' : 'Schrijf je in voor deze editie'}
          </h2>
          <p class="body">
            {isWaitlist
              ? 'Laat je gegevens achter en je hoort als eerste wanneer de inschrijvingen openen. Gratis en zonder verplichting.'
              : 'Vul je gegevens in en rond af. Je krijgt meteen een bevestiging per mail.'}
          </p>
          <form
            id="waitlist-form"
            method="post"
            action="/api/waitlist"
            data-age-min={e.ageMin}
            data-age-max={e.ageMax}
            novalidate
          >
            <input type="hidden" name="event" value={event.id} />
            <div class="field">
              <label for="naam">Voornaam deelnemer</label>
              <input id="naam" name="naam" type="text" autocomplete="given-name" required />
              <span class="err" role="alert"></span>
            </div>
            <div class="field">
              <label for="leeftijd">Leeftijd</label>
              <input id="leeftijd" name="leeftijd" type="number" inputmode="numeric"
                     min={e.ageMin} max={e.ageMax} required />
              <span class="err" role="alert"></span>
            </div>
            <div class="field">
              <label for="email">E-mailadres ouder</label>
              <input id="email" name="email" type="email" autocomplete="email" required />
              <span class="err" role="alert"></span>
            </div>
            <div class="field">
              <label for="gemeente">Gemeente (optioneel)</label>
              <input id="gemeente" name="gemeente" type="text" />
              <span class="err" role="alert"></span>
            </div>
            {/* The child's first name and age are above this line, so the
                guardian's tick is the lawful basis for holding them. Unticked by
                default, and re-checked in the API route — the browser check is a
                courtesy, the server one is what counts. */}
            <div class="field field--check">
              <input type="checkbox" id="wl-consent" name="consent" value="ja" />
              <label for="wl-consent">
                Ik ben de ouder of voogd, en ik ga akkoord met de
                <a href="/privacy">privacyverklaring</a> voor het verwerken van deze gegevens.
              </label>
              <span class="err" role="alert"></span>
            </div>
            <button type="submit" class="pill pill--primary">
              {isWaitlist ? 'Zet me op de wachtlijst' : 'Schrijf me in'}
            </button>
          </form>
          <p class="meta" style="margin-top:18px">
            Prijs volgt bij bevestiging. Heb je financiële ondersteuning nodig? Ontdek
            <a href="/social-impact" style="color:var(--red);font-weight:600">IMPACT FOR ALL</a>.
          </p>
        </div>
      )}

      {e.practical.length > 0 && (
        <div class="practical">
          <span class="label">[ Praktisch ]</span>
          <div style="margin-top:18px">
            {e.practical.map((row) => (
              <div class="row"><span>{row.k}</span><span>{row.v}</span></div>
            ))}
          </div>
        </div>
      )}
    </aside>
  </div>

  {e.gallery.length > 0 && (
    <section class="section section--sand">
      <div class="wrap">
        <div class="sec-head">
          <span class="running">Editie {e.editionYear}</span>
          <div><h2 class="d-l">This was {e.title.replace(/^IMPACT [^—]+— /, '')}</h2></div>
          <p><a href="/journal" class="tlink">Bekijk de recap in journal</a></p>
        </div>
        <div class="gallery">
          {e.gallery.map((g) => <img src={'/' + g.src.replace(/^\//, '')} alt={g.alt} loading="lazy" />)}
        </div>
      </div>
    </section>
  )}

  <section class="band" id="contact">
    <div class="wrap">
      <div>
        <h2 class="d-l d-l--44">Nog vragen over deze editie?</h2>
        <p class="body" style="margin-top:14px">
          Ouders, scholen en clubs kunnen ons altijd rechtstreeks contacteren.
        </p>
      </div>
      <div style="display:flex;gap:12px;flex-wrap:wrap">
        <a href="/contact" class="pill pill--primary">Contacteer ons</a>
        <a href="/assets/impact-brochure.pdf" target="_blank" rel="noopener" class="pill pill--ghost">
          Download brochure
        </a>
      </div>
    </div>
  </section>

  <div class="mobile-cta">
    <a href="#wachtlijst" class="pill pill--primary">
      {e.status === 'past' ? 'Bekijk de recap' : isOpen ? 'Schrijf je in' : 'Zet me op de wachtlijst'}
    </a>
  </div>
</Base>
