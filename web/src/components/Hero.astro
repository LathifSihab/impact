---
interface Props {
  /** poster image, relative to /public */
  image: string;
  alt: string;
  /** optional per-page video basename in /assets/video (no extension) */
  video?: string;
  label?: string;
  kicker?: string;
  title: string;
  standfirst?: string;
  /** small proof points under the headline (Foodmaker pattern) */
  trust?: string[];
  pills?: { label: string; tone?: 'red' | 'plain' }[];
  variant?: 'home' | 'page' | 'event';
  /** split the headline into animated lines on load */
  split?: boolean;
}

const {
  image, alt, video, label, kicker, title, standfirst,
  trust = [], pills = [], variant = 'page', split = false,
} = Astro.props;

const classes = ['hero', variant === 'page' && 'hero--page', variant === 'event' && 'hero--event']
  .filter(Boolean)
  .join(' ');
const src = image.startsWith('/') ? image : '/' + image;
---

<header class={classes} data-reveal-root>
  <img
    src={src}
    alt={alt}
    data-hero-poster
    data-video-webm={video ? `/assets/video/${video}.webm` : undefined}
    data-video-mp4={video ? `/assets/video/${video}.mp4` : undefined}
  />
  <div class="hero-content wrap">
    <div>
      {pills.length > 0 && (
        <div class="pills reveal">
          {pills.map((p) => (
            <span class:list={['pill', 'pill--static', p.tone === 'red' && 'is-red']}>{p.label}</span>
          ))}
        </div>
      )}
      {label && <span class="label reveal">{label}</span>}
      {kicker && <div class="kicker reveal" set:html={kicker} />}
      <h1 class:list={[variant === 'home' ? 'd-xl' : 'd-xl', 'reveal']} data-split={split || undefined}>{title}</h1>
      {trust.length > 0 && (
        <ul class="trust reveal">{trust.map((t) => <li>{t}</li>)}</ul>
      )}
      {standfirst && <p class:list={[variant === 'event' ? 'stand' : 'intro', 'reveal']}>{standfirst}</p>}
      <slot />
    </div>
  </div>
</header>
