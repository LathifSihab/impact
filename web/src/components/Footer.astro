---
interface Props { hasOwnSignup?: boolean }
const { hasOwnSignup = false } = Astro.props;

const columns: [string, [string, string][]][] = [
  ['IMPACT', [['Over', '/over'], ['Fundamenten', '/over#fundamenten'], ['Team', '/over#team']]],
  ['Events', [['Upcoming', '/events#upcoming'], ['Camps', '/events#camps'], ['Days', '/events#days'],
              ['Retreats', '/events#retreats'], ['Hosted Experiences', '/hosted-experiences']]],
  ['Samenwerken', [['Partner worden', '/samenwerken#partner-worden'],
                   ['Hosted Experiences', '/hosted-experiences'],
                   ['Voor bedrijven', '/samenwerken#bedrijven']]],
  ['Social impact', [['IMPACT FOR ALL', '/social-impact'],
                     ['Steun onze missie', '/social-impact#draag-bij']]],
  ['Info', [['Journal', '/journal'], ['Media', '/media'],
            ['Brochure', '/assets/impact-brochure.pdf'], ['Contact', '/contact']]],
];
---

{!hasOwnSignup && (
  <section class="news-band">
    <div class="wrap">
      <div>
        <span class="label">[ Nieuwsbrief ]</span>
        <h2 class="d-l d-l--40" style="margin:16px 0 12px">Join the IMPACT community</h2>
        <p class="body">Nieuwe events, verhalen en partnerships — één mail per maand.</p>
      </div>
      <form class="news-form" data-newsletter method="post" action="/api/newsletter" novalidate>
        <div class="field-row">
          <label class="sr-only" for="footer-news">E-mailadres</label>
          <input id="footer-news" type="email" name="email" placeholder="jouw e-mailadres" required />
          <button type="submit" class="pill pill--primary">Inschrijven</button>
        </div>
        <p class="form-msg" role="status"></p>
        <p class="meta">Geen spam. Uitschrijven kan altijd.</p>
      </form>
    </div>
  </section>
)}

<footer class="footer">
  <div class="wrap">
    <div class="grid">
      <div class="brandcol">
        <a href="/" class="logo logo--invert">
          <img src="/assets/brand/impact-logo.png" alt="IMPACT" width="647" height="145" />
        </a>
        <p class="body">Youth development through experiences, connection and growth.</p>
        <div class="socials">
          <a href="https://www.instagram.com/impact___collective/" target="_blank" rel="noopener">Instagram</a>
        </div>
      </div>
      {columns.map(([head, links]) => (
        <div>
          <h4>{head}</h4>
          <ul>{links.map(([label, href]) => <li><a href={href}>{label}</a></li>)}</ul>
        </div>
      ))}
    </div>
    <div class="bottom">
      <span>
        hello@wemakeimpact.be · <a href="tel:+32495370044">+32 495 37 00 44</a> ·
        <a href="https://www.instagram.com/impact___collective/" target="_blank" rel="noopener">@impact___collective</a>
      </span>
      <span class="built">Built by <a href="https://drpbuildlab.com" target="_blank" rel="noopener">DRP BuildLab</a></span>
    </div>
  </div>
</footer>
